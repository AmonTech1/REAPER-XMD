{
  "name": "REAPER-XMD",
  "description": "WhatsApp bot by Amon Tech",
  "logo": "https://raw.githubusercontent.com/AmonTech1/REAPER-XMD/a3aa6169969c7872247b6beeabd87192d7d33378/REAPER-XMD.jpg",
  "keywords": ["REAPER-XMD"],
  "repository": "https://github.com/AmonTech1/REAPER-XMD",
  "stack": "heroku-24",

  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },

  "env": {
    "SESSION_ID": {
      "description": "Your session ID (must start with benzo~)",
      "required": true,
      "value": ""
    },
    "OWNER_NUMBER": {
      "description": "Owner's phone number with country code (e.g., 2547XXXXXXXX)",
      "required": true,
      "value": ""
    },
    "BOT_OWNER": {
      "description": "Bot owner name",
      "required": true,
      "value": ""
    },
    "AUTHOR": {
      "description": "Author name for stickers",
      "required": false,
      "value": ""
    },
    "BOT_NAME": {
      "description": "Bot display name",
      "required": true,
      "value": "★彡 [ ℝ𝔼𝔸ℙ𝔼ℝ 𝕏𝕄𝔻 ] 彡★"
    },
    "PACKNAME": {
      "description": "Package name for stickers",
      "required": false,
      "value": "★彡 [ ℝ𝔼𝔸ℙ𝔼ℝ 𝕏𝕄𝔻 ] 彡★"
    },
    "PREFIXES": {
      "description": "Command prefixes (comma-separated, e.g., .,!)",
      "required": true,
      "value": "."
    },
    "COMMAND_MODE": {
      "description": "Command mode: private, public, inbox, or groups",
      "required": true,
      "value": "private"
    },
    "TIMEZONE": {
      "description": "Your timezone (e.g., Africa/Nairobi)",
      "required": true,
      "value": "Africa/Nairobi"
    },
    "MONGO_URL": {
      "description": "MongoDB URL (optional)",
      "required": false,
      "value": ""
    },
    "POSTGRES_URL": {
      "description": "PostgreSQL URL - Recommended (e.g., Supabase)",
      "required": false,
      "value": ""
    },
    "MYSQL_URL": {
      "description": "MySQL URL (optional)",
      "required": false,
      "value": ""
    },
    "DB_URL": {
      "description": "SQLite path (optional)",
      "required": false,
      "value": ""
    }
  },

  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
